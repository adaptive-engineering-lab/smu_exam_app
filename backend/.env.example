# ── Database ──────────────────────────────────────────────────────────────────
# Supabase Postgres (Session mode, port 5432)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
# Or direct connection:
# DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL — Settings > API > Project URL
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Service role key — Settings > API > service_role (keep secret!)
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# JWT secret — Settings > API > JWT Settings > JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here
# Storage bucket name (create in Supabase Storage dashboard)
SUPABASE_STORAGE_BUCKET=submissions
# Set to false to use local filesystem instead (dev only)
USE_SUPABASE_STORAGE=true

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
FRONTEND_URL=http://localhost:5173

# ── Gunicorn (production) ─────────────────────────────────────────────────────
GUNICORN_WORKERS=2
