# ── Database ──────────────────────────────────────────────────────────────────
# Local dev
DATABASE_URL=postgresql://pgadmin:password@localhost:5432/smu_exam
# Azure Database for PostgreSQL Flexible Server example:
# DATABASE_URL=postgresql://adminuser:YourPassword@your-server.postgres.database.azure.com:5432/smu_exam?sslmode=require

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ──────────────────────────────────────────────────────────────────────
# Local dev
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:5174"]
# Production (Azure Static Web Apps URL):
# ALLOWED_ORIGINS=["https://your-app.azurestaticapps.net"]

FRONTEND_URL=http://localhost:5173
# Production:
# FRONTEND_URL=https://your-app.azurestaticapps.net

# ── Email (SMTP) ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.yourdomain.com
SMTP_PORT=587
SMTP_USER=noreply@yourdomain.com
SMTP_PASSWORD=yourpassword
SMTP_FROM=noreply@yourdomain.com

# ── PDF / File Storage ────────────────────────────────────────────────────────
# Set to true to store PDFs in Azure Blob Storage instead of local disk.
# Local filesystem does NOT persist across App Service restarts — use Azure Blob in production.
USE_AZURE_STORAGE=false
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER=submissions

# ── Gunicorn (production) ─────────────────────────────────────────────────────
# Number of worker processes. Recommended: (2 x CPU cores) + 1
GUNICORN_WORKERS=2
# Port is set automatically by Azure App Service via the PORT env var
